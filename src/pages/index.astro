    <!-- Scripts -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Mobile Menu Toggle Logic
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        if (mobileMenuBtn && mobileMenu) {
          mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
          });

          mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
            });
          });
        }

        // Slideshow Logic
        const slides = document.querySelectorAll('.slide-img');
        const dots = document.querySelectorAll('.slide-dot');
        let currentIndex = 0;
        const totalSlides = slides.length;

        function changeSlide() {
          if (!slides.length) return;
          slides[currentIndex].classList.remove('active');
          dots[currentIndex].classList.remove('bg-amber-800', 'w-8', 'sm:w-12');
          dots[currentIndex].classList.add('bg-stone-400/70', 'w-6', 'sm:w-8');

          currentIndex = (currentIndex + 1) % totalSlides;

          slides[currentIndex].classList.add('active');
          dots[currentIndex].classList.remove('bg-stone-400/70', 'w-6', 'sm:w-8');
          dots[currentIndex].classList.add('bg-amber-800', 'w-8', 'sm:w-12');
        }

        if (totalSlides > 1) {
          setInterval(changeSlide, 5000);
        }
      });
    </script>
